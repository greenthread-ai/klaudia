.DS_Store

# Local Klaudia config (may contain API keys)
.klaudia/

# Stray local build artifact (build with: go build -o /tmp/klaudia ./cmd/klaudia)
/klaudia

# Legacy JS artifacts (the JS reference lives on the js-reference branch)
/node_modules
/dist

# MCP server config. There is no ${VAR} expansion, so any credential in here is
# a literal in a file — and the subprocess inherits Klaudia's environment, so it
# does not need to be. See .mcp.json.example. Commit a secret-free team config
# with `git add -f .mcp.json` if you want one.
/.mcp.json
